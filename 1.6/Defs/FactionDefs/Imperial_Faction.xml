<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Imperial</defName>
        <label>Empire of Cyrodiil</label>
        <description>The Empire of Cyrodiil is the seat of power at the heart of Tamriel. From the Imperial City on the shores of Lake Rumare, the Emperor rules through the Elder Council and the legions of disciplined soldiers that enforce Imperial law across the continent. Cyrodiil's strength lies not in conquest alone but in the institutions that follow it: Imperial law, the Mages Guild, the Merchants Guild, and the faith of the Nine Divines bind their subjects together long after the fighting has stopped. Whether on the plains of the homeland or far beyond its borders, every Imperial settlement carries the same promise: order, law, and civilization where there was none before.</description>
        <colorSpectrum>
            <li>(0.72, 0.12, 0.12)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Imperial</pawnSingular>
        <pawnsPlural>Imperials</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.3</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Emperor</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>Empire of Cyrodiil</fixedName>
        <allowedCultures>
            <li>ESCP_Culture_Imperial</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Imperial</li>
        </royalTitleTags>
        <royalFavorLabel>Imperial Merit</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>Eight Divines</ideoName>
        <ideoDescription>The Eight Divines (Akatosh, Arkay, Dibella, Julianos, Kynareth, Mara, Stendarr, and Zenithar) are the foundation of Imperial faith, maintained in every temple from the Imperial City to the outermost provinces. The White-Gold Concordat struck Talos from the count as the price of ending the Great War, and the Empire paid it. Imperial theologians do not pretend the wound is small. They argue instead that the institution outlasts any single article of the peace: that the temples, the rites, and the communion of the faithful are worth more intact than destroyed in a war the legions cannot yet win. The Empire endures by knowing which battles to fight and when.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Akatosh</name><type>Dragon God of Time and chief of the Divines</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityAkatosh</iconPath>
            </li>
            <li>
                <nameType><name>Kynareth</name><type>goddess of air, sky, and the natural world</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityKynareth</iconPath>
            </li>
            <li>
                <nameType><name>Mara</name><type>goddess of love, family, and compassion</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityMara</iconPath>
            </li>
            <li>
                <nameType><name>Dibella</name><type>goddess of beauty, art, and affection</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityDibella</iconPath>
            </li>
            <li>
                <nameType><name>Stendarr</name><type>god of mercy, righteous might, and divine justice</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityStendarr</iconPath>
            </li>
            <li>
                <nameType><name>Arkay</name><type>god of the cycle of life, death, and funerary custom</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityArkay</iconPath>
            </li>
            <li>
                <nameType><name>Julianos</name><type>god of wisdom, logic, and scholarship</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityJulianos</iconPath>
            </li>
            <li>
                <nameType><name>Zenithar</name><type>god of work, commerce, and earthly endeavor</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityZenithar</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Imperial</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_EightDivines</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <xenotypeSet>
            <xenotypeChances>
                <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
                <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
                <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
                <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
                <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
                <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
                <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
            </xenotypeChances>
        </xenotypeSet>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Imperial_Child</li>
                    <li>ESCP_Backstory_Imperial_Citizen</li>
                    <li>ESCP_Backstory_Colovian_Child</li>
                    <li>ESCP_Backstory_Colovian_Citizen</li>
                    <li>ESCP_Backstory_Nibenean_Child</li>
                    <li>ESCP_Backstory_Nibenean_Citizen</li>
                </categories>
                <commonality>0.95</commonality>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Imperial_Merchant</li>
            <li>ESCP_Caravan_Imperial_Quartermaster</li>
        </caravanTraderKinds>

        <visitorTraderKinds>
            <li>ESCP_Caravan_Imperial_Merchant</li>
        </visitorTraderKinds>

        <baseTraderKinds>
            <li>ESCP_Caravan_Imperial_Merchant</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Imperial_Legionnaire>10</ESCP_Pawnkind_Imperial_Legionnaire>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Archer>5</ESCP_Pawnkind_Imperial_Legionnaire_Archer>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary>8</ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary>
                    <ESCP_Pawnkind_Imperial_Mage>4</ESCP_Pawnkind_Imperial_Mage>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>3</ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>
                    <ESCP_Pawnkind_Imperial_Blade>2</ESCP_Pawnkind_Imperial_Blade>
                    <ESCP_Pawnkind_Imperial_Legate>1</ESCP_Pawnkind_Imperial_Legate>
                    <ESCP_Pawnkind_Minotaur_Imperial MayRequire="Rick.ESCP.Minotaurs">0.3</ESCP_Pawnkind_Minotaur_Imperial>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Imperial_Citizen>20</ESCP_Pawnkind_Imperial_Citizen>
                    <ESCP_Pawnkind_Imperial_Watch>12</ESCP_Pawnkind_Imperial_Watch>
                    <ESCP_Pawnkind_Imperial_Merchant>10</ESCP_Pawnkind_Imperial_Merchant>
                    <ESCP_Pawnkind_Imperial_Mage>5</ESCP_Pawnkind_Imperial_Mage>
                    <ESCP_Pawnkind_Imperial_Noble>3</ESCP_Pawnkind_Imperial_Noble>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Imperial_Trader>1</ESCP_Pawnkind_Imperial_Trader>
                    <ESCP_Pawnkind_Imperial_Quartermaster>1</ESCP_Pawnkind_Imperial_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Imperial_Legionnaire>10</ESCP_Pawnkind_Imperial_Legionnaire>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Archer>4</ESCP_Pawnkind_Imperial_Legionnaire_Archer>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>2</ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Imperial_Citizen>8</ESCP_Pawnkind_Imperial_Citizen>
                    <ESCP_Pawnkind_Imperial_Watch>12</ESCP_Pawnkind_Imperial_Watch>
                    <ESCP_Pawnkind_Imperial_Legionnaire>10</ESCP_Pawnkind_Imperial_Legionnaire>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Archer>8</ESCP_Pawnkind_Imperial_Legionnaire_Archer>
                    <ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>5</ESCP_Pawnkind_Imperial_Legionnaire_Expeditionary_Heavy>
                    <ESCP_Pawnkind_Imperial_Palace_Guard>3</ESCP_Pawnkind_Imperial_Palace_Guard>
                    <ESCP_Pawnkind_Imperial_Blade>3</ESCP_Pawnkind_Imperial_Blade>
                    <ESCP_Pawnkind_Imperial_Legate>2</ESCP_Pawnkind_Imperial_Legate>
                    <ESCP_Pawnkind_Minotaur_Imperial MayRequire="Rick.ESCP.Minotaurs">0.15</ESCP_Pawnkind_Minotaur_Imperial>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_Empire</li>
                    <li>ESCP_AllFlags</li>
                    <li>ESCP_OpposesNecromancy</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Empire of Cyrodiil</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_ImperialLegion</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_ImperialLegion</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Imperial City</li>
                    <li>Chorrol</li>
                    <li>Bruma</li>
                    <li>Anvil</li>
                    <li>Skingrad</li>
                    <li>Kvatch</li>
                    <li>Cheydinhal</li>
                    <li>Leyawiin</li>
                    <li>Bravil</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>TemperateSwamp</li>
                    <li>AridShrubland</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
            <li Class="ESCP.Core.Crime.FactionExtension_Law" />
        </modExtensions>
    </FactionDef>

</Defs>
