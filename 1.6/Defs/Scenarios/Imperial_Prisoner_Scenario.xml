<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ScenarioDef>
        <defName>ESCP_Scenario_ImperialPrisoner</defName>
        <label>Prisoner of the Empire</label>
        <description>You have seen the inside of an Imperial City cell, the hold of a prison ship and the back of a cart with your hands bound. Somewhere along the way a pardon caught up with you. The guards cut your ropes at a lonely crossroads, tossed you a sack of rations and rode off without a word.\n\nChoose any race of Tamriel for your prisoner. Nobody here knows who you are, and nobody is coming to tell you what to do next.</description>
        <scenario>
            <summary>A lone prisoner of any race, freed by an Imperial pardon and left with almost nothing.</summary>
            <playerFaction>
                <def>PlayerFaction</def>
                <factionDef>ESCP_Faction_Prisoner_Player</factionDef>
            </playerFaction>
            <surfaceLayer>
                <def>SurfaceLayerFixed</def>
                <tag>Surface</tag>
                <layer>Surface</layer>
                <settingsDef>Surface</settingsDef>
                <hide>true</hide>
                <connections>
                    <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
                        <zoomMode>ZoomOut</zoomMode>
                    </Orbit>
                </connections>
            </surfaceLayer>
            <parts>
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
                    <def>ConfigPage_ConfigureStartingPawns</def>
                    <pawnCount>1</pawnCount>
                    <pawnChoiceCount>8</pawnChoiceCount>
                </li>
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>30</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Pemmican</thingDef>
                    <count>60</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineHerbal</thingDef>
                    <count>4</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MeleeWeapon_Knife</thingDef>
                    <stuff>Steel</stuff>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
