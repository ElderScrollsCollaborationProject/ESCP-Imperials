<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Imperial_VoiceEmperor</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>awed by presence</label>
        <description>This pawn has been caught in the grip of Imperial authority. Their will to fight has faltered; their focus and capacity for action are severely reduced until the effect releases them.</description>
        <defaultLabelColor>(1.0, 0.9, 0.35)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.3</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

</Defs>
