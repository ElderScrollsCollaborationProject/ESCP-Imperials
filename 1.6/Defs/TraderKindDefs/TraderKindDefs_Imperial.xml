<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <TraderKindDef>
        <defName>ESCP_Caravan_Imperial_Merchant</defName>
        <label>Imperial merchant</label>
        <modExtensions>
            <li Class="ESCP.Currencies.CurrencyReplacement">
                <currency>ESCP_Currency_Septims</currency>
            </li>
            <li Class="ESCP.Currencies.BullionBuyer">
                <sellPriceFactor>1.25</sellPriceFactor>
            </li>
        </modExtensions>

        <stockGenerators>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Pemmican</thingDef>
                <countRange>80~200</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>MealSimple</thingDef>
                <countRange>15~40</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Beer</thingDef>
                <countRange>20~50</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Cloth</thingDef>
                <countRange>60~160</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>80~200</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>WoodLog</thingDef>
                <countRange>100~250</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>8~22</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>300~800</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Gold</thingDef>
                <countRange>15~50</countRange>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>ExoticMisc</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>ESCP_Resources_Raw</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>150~500</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
                <tradeTag>ESCP_ElementalSalts</tradeTag>
                <thingDefCountRange>1~2</thingDefCountRange>
                <countRange>4~12</countRange>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>ESCP_Bullion</tag>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ESCP_Resource_Gold_Ingot</thingDef>
                <countRange>0~3</countRange>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <TraderKindDef>
        <defName>ESCP_Caravan_Imperial_Quartermaster</defName>
        <label>Imperial quartermaster</label>
        <modExtensions>
            <li Class="ESCP.Currencies.CurrencyReplacement">
                <currency>ESCP_Currency_Septims</currency>
            </li>
        </modExtensions>

        <stockGenerators>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Pemmican</thingDef>
                <countRange>100~300</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>150~400</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Cloth</thingDef>
                <countRange>40~100</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>15~35</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineIndustrial</thingDef>
                <countRange>5~12</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>200~600</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Leather_Armor</thingDef>
                <countRange>2~6</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Studded_Armor</thingDef>
                <countRange>1~4</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Legion_Uniform</thingDef>
                <countRange>2~6</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Legion_Helmet</thingDef>
                <countRange>2~6</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Light_Helmet</thingDef>
                <countRange>1~5</countRange>
            </li>

            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.ImperialArmory">
                <thingDef>ESCP_Apparel_Imperial_Steel_Armor</thingDef>
                <countRange>1~3</countRange>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>ESCP_Resources_Raw</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>150~500</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
                <tradeTag>ESCP_ElementalSalts</tradeTag>
                <thingDefCountRange>1~2</thingDefCountRange>
                <countRange>4~12</countRange>
            </li>

        </stockGenerators>
    </TraderKindDef>

</Defs>
